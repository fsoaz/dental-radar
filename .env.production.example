# Production secrets — copy to .env.production and fill in values.
# Never commit .env.production to git.

POSTGRES_USER=dental_radar
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=dental_radar

JWT_SECRET=change-me-long-random-secret
# Required for all mutating/paid API routes (X-API-Key header).
API_KEY=change-me-operator-api-key
# Must stay false (or unset) in production. Auth fails closed when API_KEY is set.
ALLOW_UNAUTHENTICATED=false
RATE_LIMIT_PER_MINUTE=30
# Proxy IPs/CIDRs whose X-Forwarded-For may set the rate-limit client key.
# Empty = trust none. Must match the reverse proxy in front of the API,
# otherwise the limit is keyed on the proxy and shared by every caller.
RATE_LIMIT_TRUSTED_PROXIES=

GOOGLE_PLACES_API_KEY=
PLACES_MAX_PAGES=3
AI_PROVIDER=gpt
OPENAI_API_KEY=
# OpenAI-compatible endpoint. Must be https:// because the API key is sent as a bearer token.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

CORS_ORIGINS=https://your-domain.example
# Browser-reachable API base URL baked into the frontend image. Do not use localhost.
NEXT_PUBLIC_API_URL=https://api.your-domain.example/api/v1

# API is bound to loopback by default; set API_BIND=0.0.0.0 only behind a trusted edge.
API_BIND=127.0.0.1
API_PORT=8000
FRONTEND_PORT=3000
# Comma-separated peers trusted for X-Forwarded-* (proxy subnet).
# Proxy addresses whose X-Forwarded-* uvicorn may trust. Empty = trust none.
# A value here makes uvicorn rewrite the peer address from the header before
# app code runs, so set it only to a proxy you control that OVERWRITES
# X-Forwarded-For. Keep in sync with RATE_LIMIT_TRUSTED_PROXIES.
FORWARDED_ALLOW_IPS=

LOG_LEVEL=INFO
LOG_JSON=true

# Container registry tags (set by CI)
GITHUB_REPOSITORY=your-org/dental-radar
IMAGE_TAG=main
# API_IMAGE=ghcr.io/your-org/dental-radar/api:main
# FRONTEND_IMAGE=ghcr.io/your-org/dental-radar/frontend:main
