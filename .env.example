# Database
DATABASE_URL=postgresql://dental_radar:dental_radar@localhost:5432/dental_radar

# Auth
# Operator key for mutating/paid routes (X-API-Key). Empty + ALLOW_UNAUTHENTICATED=false → 503.
API_KEY=
# Explicit local/test escape hatch. Default is fail-closed (false) even when
# APP_ENV=development — forgetting APP_ENV=production must not open billed routes.
ALLOW_UNAUTHENTICATED=true
RATE_LIMIT_PER_MINUTE=30
REDIS_URL=redis://localhost:6379/0
# Proxy IPs/CIDRs whose X-Forwarded-For may set the rate-limit client key.
# Empty = trust none (use the direct peer address). Set only to your proxy.
RATE_LIMIT_TRUSTED_PROXIES=
# uvicorn trusted proxies for X-Forwarded-*. Empty = trust none. Keep in sync
# with RATE_LIMIT_TRUSTED_PROXIES; the proxy must overwrite XFF, not append.
FORWARDED_ALLOW_IPS=

# Google Places (Phase 2+)
GOOGLE_PLACES_API_KEY=
# Max result pages fetched per discover query (20 results/page) to cap API spend
PLACES_MAX_PAGES=3

# AI enrichment (Phase 5+)
AI_PROVIDER=gpt
AI_FALLBACK_PROVIDER=
AI_RETRY_MAX=3
AI_MAX_SITE_TEXT_CHARS=8000
OPENAI_API_KEY=
# OpenAI-compatible endpoint (e.g. https://openrouter.ai/api/v1). Must be https:// — the
# API key is sent here as a bearer token. Blank values fall back to the OpenAI default.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Frontend (Phase 6+). Dev compose allows localhost/127.0.0.1/0.0.0.0 on ports 3000-3001;
# production should set only the public frontend origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000,http://localhost:3001,http://127.0.0.1:3001,http://0.0.0.0:3001

# Operations (Phase 7+)
LOG_LEVEL=INFO
LOG_JSON=true
APP_ENV=development
