# Database
DATABASE_URL=postgresql://dental_radar:dental_radar@localhost:5432/dental_radar

# Auth (Phase 2+)
JWT_SECRET=change-me-in-production

# Google Places (Phase 2+)
GOOGLE_PLACES_API_KEY=
# Max result pages fetched per discover query (20 results/page) to cap API spend
PLACES_MAX_PAGES=3

# AI enrichment (Phase 5+)
AI_PROVIDER=gpt
AI_FALLBACK_PROVIDER=
AI_RETRY_MAX=3
AI_MAX_SITE_TEXT_CHARS=8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Frontend (Phase 6+)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Operations (Phase 7+)
LOG_LEVEL=INFO
LOG_JSON=true
APP_ENV=development
